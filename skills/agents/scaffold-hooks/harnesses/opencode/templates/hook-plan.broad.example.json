{
  "scope": "project",
  "mode": "additive",
  "plugin_name": "opencode-froggy",
  "hooks_root": "hooks",
  "config_target": "opencode.json",
  "hook_config_target": ".opencode/hook/hooks.md",
  "managed_state_dir": ".opencode/hook/.managed",
  "hooks": [
    {
      "event": "session.created",
      "conditions": [
        "isMainSession"
      ],
      "actions": [
        {
          "bash": "if [ -f \"$OPENCODE_PROJECT_DIR/scripts/agent-session-context.sh\" ]; then AGENT_HOOK_HARNESS=opencode AGENT_HOOK_PROJECT_ROOT=\"$OPENCODE_PROJECT_DIR\" AGENT_HOOK_SESSION_ID=\"$OPENCODE_SESSION_ID\" bash \"$OPENCODE_PROJECT_DIR/scripts/agent-session-context.sh\" >/dev/null; fi"
        }
      ],
      "notes": "Root-session bootstrap."
    },
    {
      "event": "session.idle",
      "conditions": [
        "isMainSession"
      ],
      "actions": [
        {
          "bash": {
            "command": "if [ -f \"$OPENCODE_PROJECT_DIR/scripts/validate-project.sh\" ]; then AGENT_HOOK_HARNESS=opencode AGENT_HOOK_PROJECT_ROOT=\"$OPENCODE_PROJECT_DIR\" AGENT_HOOK_SESSION_ID=\"$OPENCODE_SESSION_ID\" bash \"$OPENCODE_PROJECT_DIR/scripts/validate-project.sh\" \"$OPENCODE_PROJECT_DIR\"; fi",
            "timeout": 600000
          }
        }
      ],
      "notes": "Post-turn project validation."
    },
    {
      "event": "tool.before.write",
      "actions": [
        {
          "bash": "file=$(cat | jq -r '.tool_args.filePath // .tool_args.file_path // .tool_args.path // \"\"'); case \"$file\" in *.env|*.pem|*.key) echo \"Blocked sensitive file write: $file\" >&2; exit 2 ;; esac"
        }
      ],
      "notes": "Example guardrail for sensitive file writes."
    },
    {
      "event": "tool.after.edit",
      "actions": [
        {
          "bash": "printf 'edited %s\\n' \"$(cat | jq -r '.tool_args.filePath // .tool_args.file_path // .tool_args.path // \"unknown\"')\" >&2"
        }
      ],
      "notes": "Example post-tool observer."
    }
  ]
}
