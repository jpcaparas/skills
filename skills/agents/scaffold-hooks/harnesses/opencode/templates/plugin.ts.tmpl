// Generated by scaffold-hooks. Rerunning the scaffold regenerates this file from the plan:
// put behaviour in the repo-owned scripts and commands the plan lists, not here.
import { spawn } from "node:child_process"
import { isAbsolute, join } from "node:path"

type Script = { label?: string; path?: string; script?: string; args?: string[]; cwd?: string }
type Command = { label?: string; command?: string; cwd?: string }
type PlanEvent = {
  name: "session.created" | "session.idle" | "tool.execute.before" | "tool.execute.after"
  matcher?: string
  timeout?: number
  scripts?: Script[]
  commands?: Command[]
  run_on_code_changes?: boolean
  code_change_extensions?: string[]
}
type Outcome = { ok: true } | { ok: false; message: string }
type Host = {
  root: string
  isMain(sessionID: string): Promise<boolean>
  resume(sessionID: string, text: string): Promise<void>
}

const PLAN: { events: PlanEvent[] } = null as never // @@PLAN@@

const planned = (name: PlanEvent["name"]) => PLAN.events.find((event) => event.name === name)
const isObject = (value: unknown): value is Record<string, unknown> =>
  typeof value === "object" && value !== null && !Array.isArray(value)
const nonEmpty = (value: unknown) => typeof value === "string" && value.length > 0
const optionalString = (value: unknown) => value === undefined || typeof value === "string"

function validScripts(items: unknown): items is Script[] {
  return (
    Array.isArray(items) &&
    items.every(
      (item) =>
        isObject(item) &&
        nonEmpty(item.path ?? item.script) &&
        (item.args === undefined || (Array.isArray(item.args) && item.args.every((arg) => typeof arg === "string"))) &&
        optionalString(item.cwd),
    )
  )
}

function validCommands(items: unknown): items is Command[] {
  return Array.isArray(items) && items.every((item) => isObject(item) && nonEmpty(item.command) && optionalString(item.cwd))
}

function run(argv: string[], cwd: string, env: Record<string, string>, input: string, seconds: number) {
  return new Promise<{ code: number | null; output: string }>((resolve) => {
    const child = spawn(argv[0], argv.slice(1), { cwd, env: { ...process.env, ...env } })
    let output = ""
    const timer = setTimeout(() => child.kill("SIGKILL"), seconds * 1000)
    child.stdout.on("data", (chunk) => (output += chunk))
    child.stderr.on("data", (chunk) => (output += chunk))
    child.on("error", (error) => {
      output += String(error)
    })
    child.on("close", (code) => {
      clearTimeout(timer)
      resolve({ code, output: output.slice(-2000) })
    })
    child.stdin.on("error", () => {})
    child.stdin.end(input)
  })
}

// Runs every script and command of the event. A malformed configuration fails before anything runs.
async function runEffects(event: PlanEvent, host: Host, sessionID: string, payload: unknown): Promise<Outcome> {
  const scripts = event.scripts ?? []
  const commands = event.commands ?? []
  if (!validScripts(scripts)) return { ok: false, message: "invalid scripts configuration in the scaffold-hooks plugin" }
  if (!validCommands(commands)) return { ok: false, message: "invalid commands configuration in the scaffold-hooks plugin" }

  const env = {
    AGENT_HOOK_HARNESS: "opencode",
    AGENT_HOOK_EVENT: event.name,
    AGENT_HOOK_PROJECT_ROOT: host.root,
    AGENT_HOOK_SESSION_ID: sessionID,
  }
  const input = JSON.stringify(payload)
  const at = (cwd?: string) => (!cwd || cwd === "." ? host.root : isAbsolute(cwd) ? cwd : join(host.root, cwd))
  const jobs = [
    ...scripts.map((item) => {
      const path = (item.path ?? item.script) as string
      return { label: item.label ?? path, argv: ["bash", isAbsolute(path) ? path : join(host.root, path), ...(item.args ?? [])], cwd: at(item.cwd) }
    }),
    ...commands.map((item) => ({ label: item.label ?? (item.command as string), argv: ["bash", "-lc", item.command as string], cwd: at(item.cwd) })),
  ]
  const failures: string[] = []
  for (const job of jobs) {
    const result = await run(job.argv, job.cwd, env, input, event.timeout ?? 600)
    if (result.code !== 0) failures.push(`- ${job.label}: ${result.code === null ? "timed out or was killed" : `exited with ${result.code}`}\n${result.output}`)
  }
  return failures.length === 0
    ? { ok: true }
    : { ok: false, message: `One or more project hook commands failed.\n\n${failures.join("\n")}\nFix the failing command output, then retry.` }
}

// True when a tracked, staged or untracked file with one of the extensions changed. Anything unreadable counts as a change so checks still run.
async function hasCodeChanges(root: string, extensions: unknown): Promise<boolean> {
  if (!Array.isArray(extensions) || !extensions.every(nonEmpty)) return true
  const pattern = new RegExp(`\\.(${extensions.map((ext) => ext.replace(/^\./, "").replace(/[.*+?^${}()|[\]\\]/g, "\\$&")).join("|")})$`, "i")
  for (const args of [["diff", "--cached", "--name-only"], ["diff", "--name-only"], ["ls-files", "--others", "--exclude-standard"]]) {
    const result = await run(["git", "-C", root, ...args], root, {}, "", 60)
    if (result.code !== 0) return true
    if (result.output.split("\n").some((line) => pattern.test(line.trim()))) return true
  }
  return false
}

// Sessions the plugin already sent back to the agent once; the next idle of such a session is skipped so a failing check cannot loop.
const continued = new Set<string>()

async function onSession(host: Host, type: string, sessionID: string) {
  const event = type === "session.created" || type === "session.idle" ? planned(type) : undefined
  if (!event || !sessionID || !(await host.isMain(sessionID))) return
  const payload = { hook_event_name: type, session_id: sessionID, cwd: host.root }

  if (type === "session.created") {
    const outcome = await runEffects(event, host, sessionID, payload)
    if (!outcome.ok) console.error(`[scaffold-hooks] ${outcome.message}`)
    return
  }
  if (continued.delete(sessionID)) return
  if (event.run_on_code_changes !== false && !(await hasCodeChanges(host.root, event.code_change_extensions))) return
  const outcome = await runEffects(event, host, sessionID, { ...payload, stop_hook_active: false })
  if (!outcome.ok) {
    await host.resume(sessionID, outcome.message)
    continued.add(sessionID)
  }
}

async function onTool(host: Host, name: "tool.execute.before" | "tool.execute.after", tool: string, sessionID: string, args: unknown) {
  const event = planned(name)
  if (!event) return
  try {
    if (event.matcher && !new RegExp(event.matcher).test(tool)) return
  } catch {
    throw new Error(`invalid matcher for ${name} in the scaffold-hooks plugin`)
  }
  const outcome = await runEffects(event, host, sessionID, { hook_event_name: name, session_id: sessionID, cwd: host.root, tool_name: tool, tool_input: args })
  if (outcome.ok) return
  if (name === "tool.execute.before") throw new Error(outcome.message)
  console.error(`[scaffold-hooks] ${outcome.message}`)
}

function sessionOf(event: any): string {
  return event.properties?.sessionID ?? event.properties?.info?.id ?? ""
}

async function onEvent(host: Host, event: any) {
  try {
    await onSession(host, event.type, sessionOf(event))
  } catch (error) {
    console.error(`[scaffold-hooks] ${event.type}: ${error}`)
  }
}

const sessionEvents = () => PLAN.events.map((event) => event.name).filter((name) => name.startsWith("session."))

export default {
  id: "scaffold-hooks",

  // Verified against OpenCode 1.19.5: `server()` is the entry point it runs.
  async server(input: any) {
    const host: Host = {
      root: input.directory,
      isMain: async (id) => !(await input.client.session.get({ path: { id } }).catch(() => ({ data: undefined }))).data?.parentID,
      resume: async (id, text) => {
        await input.client.session.promptAsync({ path: { id }, body: { parts: [{ type: "text", text }] } })
      },
    }
    const hooks: Record<string, (...args: any[]) => Promise<void>> = {}
    if (planned("tool.execute.before")) hooks["tool.execute.before"] = (i, o) => onTool(host, "tool.execute.before", i.tool, i.sessionID, o.args)
    if (planned("tool.execute.after")) hooks["tool.execute.after"] = (i) => onTool(host, "tool.execute.after", i.tool, i.sessionID, i.args)
    if (sessionEvents().length > 0) hooks.event = ({ event }) => onEvent(host, event)
    return hooks
  },
}
