{
  "mode": "additive",
  "hooks_root": "hooks",
  "cleanup_legacy": true,
  "harnesses": [
    "claude",
    "codex",
    "copilot",
    "devin",
    "opencode"
  ],
  "plans": {
    "claude": {
      "settings_target": ".claude/settings.json",
      "enabled_events": [
        {
          "name": "SessionStart",
          "matcher": "startup|resume|clear|compact",
          "async": false,
          "timeout": 20,
          "scripts": [
            {
              "label": "session context",
              "path": "scripts/agent-session-context.sh",
              "args": [
                "claude"
              ],
              "cwd": "."
            }
          ],
          "commands": [],
          "notes": "Print additional context for the session; the repo script writes the hookSpecificOutput JSON."
        },
        {
          "name": "Stop",
          "async": false,
          "timeout": 300,
          "scripts": [
            {
              "label": "shared stop checks",
              "path": "scripts/agent-stop-checks.sh",
              "args": [
                "claude"
              ],
              "cwd": "."
            }
          ],
          "commands": [],
          "notes": "End-of-turn quality gate; skipped when no code changed or stop_hook_active is set."
        }
      ]
    },
    "codex": {
      "hooks_target": ".codex/hooks.json",
      "feature_scope": "project",
      "enabled_events": [
        {
          "name": "SessionStart",
          "matcher": "startup|resume|clear",
          "timeout": 20,
          "status_message": "Loading shared agent hook context",
          "scripts": [
            {
              "label": "session context",
              "path": "scripts/agent-session-context.sh",
              "args": [
                "codex"
              ],
              "cwd": "."
            }
          ],
          "commands": [],
          "notes": "Print additional context for the session."
        },
        {
          "name": "Stop",
          "timeout": 300,
          "status_message": "Running shared end-of-turn checks",
          "scripts": [
            {
              "label": "shared stop checks",
              "path": "scripts/agent-stop-checks.sh",
              "args": [
                "codex"
              ],
              "cwd": "."
            }
          ],
          "commands": [],
          "notes": "End-of-turn quality gate."
        }
      ]
    },
    "devin": {
      "hooks_target": ".devin/hooks.v1.json",
      "enabled_events": [
        {
          "name": "SessionStart",
          "matcher": "",
          "timeout": 20,
          "block_on_failure": false,
          "scripts": [
            {
              "label": "session context",
              "path": "scripts/agent-session-context.sh",
              "args": [
                "devin"
              ],
              "cwd": "."
            }
          ],
          "commands": [],
          "notes": "Print additional context for the session."
        },
        {
          "name": "Stop",
          "matcher": "",
          "timeout": 300,
          "block_on_failure": true,
          "scripts": [
            {
              "label": "shared stop checks",
              "path": "scripts/agent-stop-checks.sh",
              "args": [
                "devin"
              ],
              "cwd": "."
            }
          ],
          "commands": [],
          "notes": "End-of-turn quality gate."
        }
      ]
    },
    "opencode": {
      "scope": "project",
      "mode": "additive",
      "enabled_events": [
        {
          "name": "session.created",
          "timeout": 20,
          "scripts": [
            {
              "label": "session context",
              "path": "scripts/agent-session-context.sh",
              "args": [
                "opencode"
              ],
              "cwd": "."
            }
          ],
          "commands": [],
          "notes": "Runs once for a main session. Output is not injected into the model context."
        },
        {
          "name": "session.idle",
          "timeout": 300,
          "scripts": [
            {
              "label": "shared stop checks",
              "path": "scripts/agent-stop-checks.sh",
              "args": [
                "opencode"
              ],
              "cwd": "."
            }
          ],
          "commands": [],
          "notes": "End-of-turn quality gate for a main session; a failure sends its output back as a prompt once. Skipped when no code changed."
        }
      ]
    },
    "copilot": {
      "hooks_target": ".github/hooks/copilot-hooks.json",
      "managed_root": ".github/copilot/hooks/generated",
      "enabled_events": [
        {
          "name": "agentStop",
          "timeoutSec": 300,
          "block_on_failure": true,
          "scripts": [
            {
              "label": "shared stop checks",
              "path": "scripts/agent-stop-checks.sh",
              "args": [
                "copilot"
              ],
              "cwd": ".",
              "notes": "Reusable repo-owned script that CI and other adapters can call too."
            }
          ],
          "commands": [],
          "notes": "Keep the agent from stopping before required repo checks pass."
        }
      ]
    }
  }
}
