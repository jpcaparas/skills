{
  "mode": "additive",
  "hooks_root": "hooks",
  "cleanup_legacy": true,
  "harnesses": [
    "claude",
    "codex",
    "copilot",
    "devin",
    "opencode"
  ],
  "plans": {
    "claude": {
      "settings_target": ".claude/settings.json",
      "enabled_events": [
        {
          "name": "SessionStart",
          "matcher": "startup|resume|clear|compact",
          "async": false,
          "timeout": 20,
          "scripts": [
            {
              "label": "session context",
              "path": "scripts/agent-session-context.sh",
              "args": [
                "claude"
              ],
              "cwd": "."
            }
          ],
          "commands": [],
          "notes": "Print additional context for the session; the repo script writes the hookSpecificOutput JSON."
        },
        {
          "name": "Stop",
          "async": false,
          "timeout": 300,
          "scripts": [
            {
              "label": "shared stop checks",
              "path": "scripts/agent-stop-checks.sh",
              "args": [
                "claude"
              ],
              "cwd": "."
            }
          ],
          "commands": [],
          "notes": "End-of-turn quality gate; skipped when no code changed or stop_hook_active is set."
        }
      ]
    },
    "codex": {
      "hooks_target": ".codex/hooks.json",
      "feature_scope": "project",
      "enabled_events": [
        {
          "name": "SessionStart",
          "matcher": "startup|resume|clear",
          "timeout": 20,
          "status_message": "Loading shared agent hook context",
          "scripts": [
            {
              "label": "session context",
              "path": "scripts/agent-session-context.sh",
              "args": [
                "codex"
              ],
              "cwd": "."
            }
          ],
          "commands": [],
          "notes": "Print additional context for the session."
        },
        {
          "name": "Stop",
          "timeout": 300,
          "status_message": "Running shared end-of-turn checks",
          "scripts": [
            {
              "label": "shared stop checks",
              "path": "scripts/agent-stop-checks.sh",
              "args": [
                "codex"
              ],
              "cwd": "."
            }
          ],
          "commands": [],
          "notes": "End-of-turn quality gate."
        }
      ]
    },
    "devin": {
      "hooks_target": ".devin/hooks.v1.json",
      "enabled_events": [
        {
          "name": "SessionStart",
          "matcher": "",
          "timeout": 20,
          "block_on_failure": false,
          "scripts": [
            {
              "label": "session context",
              "path": "scripts/agent-session-context.sh",
              "args": [
                "devin"
              ],
              "cwd": "."
            }
          ],
          "commands": [],
          "notes": "Print additional context for the session."
        },
        {
          "name": "Stop",
          "matcher": "",
          "timeout": 300,
          "block_on_failure": true,
          "scripts": [
            {
              "label": "shared stop checks",
              "path": "scripts/agent-stop-checks.sh",
              "args": [
                "devin"
              ],
              "cwd": "."
            }
          ],
          "commands": [],
          "notes": "End-of-turn quality gate."
        }
      ]
    },
    "opencode": {
      "scope": "project",
      "plugin_name": "opencode-froggy",
      "config_target": "opencode.json",
      "hook_config_target": ".opencode/hook/hooks.md",
      "managed_state_dir": ".opencode/hook/.managed",
      "hooks": [
        {
          "event": "session.created",
          "conditions": [
            "isMainSession"
          ],
          "actions": [
            {
              "bash": {
                "command": "if [ -f \"$OPENCODE_PROJECT_DIR/scripts/agent-session-context.sh\" ]; then AGENT_HOOK_HARNESS=opencode AGENT_HOOK_PROJECT_ROOT=\"$OPENCODE_PROJECT_DIR\" AGENT_HOOK_SESSION_ID=\"$OPENCODE_SESSION_ID\" bash \"$OPENCODE_PROJECT_DIR/scripts/agent-session-context.sh\" >/dev/null; fi",
                "timeout": 20000
              }
            }
          ],
          "notes": "Record a repo-owned session baseline when scripts/agent-session-context.sh exists."
        },
        {
          "event": "session.idle",
          "conditions": [
            "isMainSession"
          ],
          "actions": [
            {
              "bash": {
                "command": "if [ -f \"$OPENCODE_PROJECT_DIR/scripts/validate-project.sh\" ]; then AGENT_HOOK_HARNESS=opencode AGENT_HOOK_PROJECT_ROOT=\"$OPENCODE_PROJECT_DIR\" AGENT_HOOK_SESSION_ID=\"$OPENCODE_SESSION_ID\" bash \"$OPENCODE_PROJECT_DIR/scripts/validate-project.sh\" \"$OPENCODE_PROJECT_DIR\"; fi",
                "timeout": 600000
              }
            }
          ],
          "notes": "Run repo-owned validation after OpenCode makes file changes."
        }
      ]
    },
    "copilot": {
      "hooks_target": ".github/hooks/copilot-hooks.json",
      "managed_root": ".github/copilot/hooks/generated",
      "enabled_events": [
        {
          "name": "agentStop",
          "timeoutSec": 300,
          "block_on_failure": true,
          "scripts": [
            {
              "label": "shared stop checks",
              "path": "scripts/agent-stop-checks.sh",
              "args": [
                "copilot"
              ],
              "cwd": ".",
              "notes": "Reusable repo-owned script that CI and other adapters can call too."
            }
          ],
          "commands": [],
          "notes": "Keep the agent from stopping before required repo checks pass."
        }
      ]
    }
  }
}
