{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash -lc 'exec \"$(git rev-parse --show-toplevel)/scripts/agent-stop-checks.sh\" codex'",
            "timeout": 900,
            "statusMessage": "Running repository validation"
          }
        ]
      }
    ]
  }
}
