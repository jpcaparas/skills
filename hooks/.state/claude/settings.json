{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/pre-tool-use/claude.sh",
            "async": false,
            "timeout": 30
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/post-tool-use/claude.sh",
            "async": true,
            "timeout": 180
          }
        ],
        "matcher": "Edit|Write|MultiEdit"
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/notification/claude.sh",
            "async": true,
            "timeout": 15
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/hooks/stop/claude.sh",
            "async": false,
            "timeout": 300
          }
        ]
      }
    ]
  }
}
