{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash -lc 'exec \"$(git rev-parse --show-toplevel)/hooks/post-tool-use/codex.sh\"'",
            "timeout": 20,
            "statusMessage": "Reviewing Bash command impact"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash -lc 'exec \"$(git rev-parse --show-toplevel)/hooks/pre-tool-use/codex.sh\"'",
            "timeout": 20,
            "statusMessage": "Checking destructive Bash commands"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash -lc 'exec \"$(git rev-parse --show-toplevel)/hooks/session-start/codex.sh\"'",
            "timeout": 20,
            "statusMessage": "Loading skills repo hook context"
          }
        ],
        "matcher": "startup|resume"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash -lc 'exec \"$(git rev-parse --show-toplevel)/hooks/stop/codex.sh\"'",
            "timeout": 300,
            "statusMessage": "Checking skills budget and repository validation"
          }
        ]
      }
    ]
  }
}
